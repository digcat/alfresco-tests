# Alfresco Test Suite - Environment Variables
# Copy this file to .env and update with your actual credentials
# IMPORTANT: Never commit .env to version control!

# Required: Alfresco Authentication Credentials
ALFRESCO_USER=admin
ALFRESCO_PASSWORD=your_password_here

# Optional: Override server configuration from config.yml
# ALFRESCO_HOST=localhost
# ALFRESCO_PORT=8080
# ALFRESCO_HTTPS=true
